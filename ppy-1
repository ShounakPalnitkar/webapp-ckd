                        callbacks: {
                            label: function(context) {
                                if (context.datasetIndex === 0) {
                                    return `Average score: ${context.raw}`;
                                } else {
                                    return `Your score: ${context.raw}`;
                                }
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 15,
                        title: {
                            display: true,
                            text: 'Risk Score'
                        }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Age Group'
                        }
                    }
                }
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
"""

# Helper functions
def generate_recommendations(risk_level, risk_factors, age, sex):
    recommendations = []
    
    if risk_level == 'high':
        recommendations.append("Consult with your doctor about kidney function tests (eGFR and urine albumin)")
        recommendations.append("Strict control of blood pressure (target <130/80 mmHg if diabetic or CKD present)")
        recommendations.append("Optimal diabetes management if applicable (target A1C <7% for most patients)")
        recommendations.append("Regular monitoring of kidney function (at least annually)")
        recommendations.append("Dietary modifications (reduce sodium, moderate protein intake)")
    elif risk_level == 'moderate':
        recommendations.append("Discuss kidney health with your doctor at your next visit")
        recommendations.append("Monitor and control blood pressure")
        recommendations.append("Manage diabetes carefully if applicable")
        recommendations.append("Consider annual kidney function screening if you have multiple risk factors")
    else:
        recommendations.append("Maintain a healthy blood pressure (<120/80 mmHg ideal)")
        recommendations.append("Stay hydrated and eat a balanced diet")
        recommendations.append("Exercise regularly")
    
    for factor in risk_factors:
        if factor['value'] > 0:
            if factor['name'] == 'Current smoker':
                recommendations.append("Quit smoking to reduce kidney disease risk")
            elif factor['name'].startswith('Obesity'):
                recommendations.append("Work on weight management through diet and exercise")
            elif factor['name'] == 'Family history' and factor.get('details'):
                recommendations.append(f"Be aware of family history of {factor['details']} and discuss screening options")
    
    if age >= 50:
        recommendations.append("Annual kidney function tests recommended due to age")
    
    if sex == 'male':
        recommendations.append("Men should be particularly vigilant about blood pressure control")
    
    return recommendations

def get_ckd_education():
    return [
        {
            'stage': '1',
            'description': 'Normal kidney function but with signs of kidney damage',
            'gfr': '90+',
            'action': 'Monitor and control blood pressure, manage diabetes if present'
        },
        {
            'stage': '2',
            'description': 'Mild loss of kidney function',
            'gfr': '60-89',
            'action': 'Regular checkups, lifestyle changes'
        },
        {
            'stage': '3',
            'description': 'Moderate loss of kidney function',
            'gfr': '30-59',
            'action': 'See a nephrologist, manage complications'
        },
        {
            'stage': '4',
            'description': 'Severe loss of kidney function',
            'gfr': '15-29',
            'action': 'Prepare for kidney failure treatment options'
        },
        {
            'stage': '5',
            'description': 'Kidney failure',
            'gfr': '<15',
            'action': 'Dialysis or kidney transplant needed'
        }
    ]

def get_specialist_recommendation(symptoms, risk_level):
    if risk_level == 'high' and symptoms >= 3:
        return {
            'type': 'Nephrologist (Kidney Specialist)',
            'reason': 'You have multiple symptoms and high risk factors for kidney disease',
            'urgency': 'Schedule an appointment within 1-2 weeks'
        }
    elif symptoms >= 2:
        return {
            'type': 'Primary Care Physician',
            'reason': 'You have some symptoms that should be evaluated',
            'urgency': 'Schedule an appointment soon'
        }
    else:
        return {
            'type': 'Primary Care Physician',
            'reason': 'Regular checkup recommended based on your risk factors',
            'urgency': 'Next routine visit'
        }

# Routes
@app.route('/')
def welcome():
    return render_template_string(WELCOME_TEMPLATE)

@app.route('/assessment', methods=['GET', 'POST'])
def assessment():
    if request.method == 'POST':
        form_data = request.form
        risk_data = calculate_risk(form_data)
        return render_template_string(RESULTS_TEMPLATE, **risk_data)
    return render_template_string(ASSESSMENT_TEMPLATE)

def calculate_risk(form_data):
    age = int(form_data.get('age', 0))
    sex = form_data.get('sex', '')
    race = form_data.get('race', '')
    hypertension = form_data.get('hypertension', 'no')
    diabetes = form_data.get('diabetes', 'no')
    duration = int(form_data.get('duration', 0))
    family_history = form_data.get('family_history', 'no')
    family_diseases = form_data.getlist('family_diseases')
    bmi = float(form_data.get('bmi', 0))
    smoking = form_data.get('smoking', 'never')
    cardiovascular = form_data.get('cardiovascular', 'no')
    symptoms = len(form_data.getlist('symptoms'))

    risk_score = 0
    risk_factors = []

    # Age points
    if age >= 60:
        risk_score += 3
        risk_factors.append({'name': 'Age (60+)', 'value': 3, 'max': 3})
    elif age >= 50:
        risk_score += 2
        risk_factors.append({'name': 'Age (50-59)', 'value': 2, 'max': 3})
    elif age >= 40:
        risk_score += 1
        risk_factors.append({'name': 'Age (40-49)', 'value': 1, 'max': 3})
    else:
        risk_factors.append({'name': 'Age (<40)', 'value': 0, 'max': 3})

    # Race points
    if race == 'black':
        risk_score += 1
        risk_factors.append({'name': 'African American', 'value': 1, 'max': 1})
    else:
        risk_factors.append({'name': 'Race/ethnicity', 'value': 0, 'max': 1})

    # Hypertension points
    if hypertension == 'yes':
        risk_score += 2
        risk_factors.append({'name': 'Hypertension', 'value': 2, 'max': 2})
    elif hypertension == 'borderline':
        risk_score += 1
        risk_factors.append({'name': 'Borderline hypertension', 'value': 1, 'max': 2})
    else:
        risk_factors.append({'name': 'No hypertension', 'value': 0, 'max': 2})

    # Diabetes points
    if diabetes == 'type2':
        risk_score += 3
        risk_factors.append({'name': 'Type 2 Diabetes', 'value': 3, 'max': 4})
    elif diabetes == 'type1':
        risk_score += 4
        risk_factors.append({'name': 'Type 1 Diabetes', 'value': 4, 'max': 4})
    elif diabetes == 'prediabetes':
        risk_score += 1
        risk_factors.append({'name': 'Prediabetes', 'value': 1, 'max': 4})
    else:
        risk_factors.append({'name': 'No diabetes', 'value': 0, 'max': 4})

    # Diabetes duration points
    if duration >= 10:
        risk_score += 2
        risk_factors.append({'name': 'Diabetes duration (10+ yrs)', 'value': 2, 'max': 2})
    elif duration >= 5:
        risk_score += 1
        risk_factors.append({'name': 'Diabetes duration (5-9 yrs)', 'value': 1, 'max': 2})
    elif duration > 0:
        risk_factors.append({'name': 'Diabetes duration (<5 yrs)', 'value': 0, 'max': 2})

    # Family history points
    family_history_points = 0
    if family_history == 'parents' or family_history == 'siblings':
        family_history_points = 1
    elif family_history == 'both':
        family_history_points = 2

    risk_score += family_history_points
    family_diseases_text = ', '.join([d.replace('ckd', 'Chronic Kidney Disease')
                                    .replace('diabetes', 'Diabetes')
                                    .replace('hypertension', 'Hypertension')
                                    .replace('heart', 'Heart Disease') 
                                    for d in family_diseases])
    
    risk_factors.append({
        'name': 'Family history',
        'value': family_history_points,
        'max': 2,
        'details': family_diseases_text
    })

    # BMI points
    if bmi >= 30:
        risk_score += 1
        risk_factors.append({'name': 'Obesity (BMI ≥30)', 'value': 1, 'max': 1})
    elif bmi >= 25:
        risk_factors.append({'name': 'Overweight (BMI 25-29.9)', 'value': 0, 'max': 1})
    else:
        risk_factors.append({'name': 'Normal weight', 'value': 0, 'max': 1})

    # Smoking points
    if smoking == 'current':
        risk_score += 1
        risk_factors.append({'name': 'Current smoker', 'value': 1, 'max': 1})
    elif smoking == 'former':
        risk_factors.append({'name': 'Former smoker', 'value': 0, 'max': 1})
    else:
        risk_factors.append({'name': 'Never smoked', 'value': 0, 'max': 1})

    # Cardiovascular disease points
    if cardiovascular == 'yes':
        risk_score += 1
        risk_factors.append({'name': 'Cardiovascular disease', 'value': 1, 'max': 1})
    else:
        risk_factors.append({'name': 'No cardiovascular disease', 'value': 0, 'max': 1})

    # Symptoms points
    if symptoms >= 3:
        risk_score += 2
        risk_factors.append({'name': 'Multiple symptoms', 'value': 2, 'max': 2})
    elif symptoms >= 1:
        risk_score += 1
        risk_factors.append({'name': 'Some symptoms', 'value': 1, 'max': 2})
    else:
        risk_factors.append({'name': 'No symptoms', 'value': 0, 'max': 2})

    # Determine risk level
    if risk_score >= 10:
        risk_level = 'high'
        risk_percentage = '20-50%'
    elif risk_score >= 6:
        risk_level = 'moderate'
        risk_percentage = '5-20%'
    else:
        risk_level = 'low'
        risk_percentage = '<5%'

    recommendations = generate_recommendations(risk_level, risk_factors, age, sex)
    immediate_visit = any(factor['name'] in [
        'Type 1 Diabetes', 'Type 2 Diabetes', 'Hypertension', 
        'Cardiovascular disease', 'Multiple symptoms'
    ] and factor['value'] > 0 for factor in risk_factors)

    ckd_education = get_ckd_education()
    specialist = get_specialist_recommendation(symptoms, risk_level)

    return {
        'risk_score': risk_score,
        'risk_level': risk_level,
        'risk_percentage': risk_percentage,
        'risk_factors': risk_factors,
        'age': age,
        'sex': sex,
        'race': race,
        'hypertension': hypertension,
        'diabetes': diabetes,
        'duration': duration,
        'family_history': family_history,
        'family_diseases_text': family_diseases_text,
        'bmi': bmi,
        'smoking': smoking,
        'cardiovascular': cardiovascular,
        'symptoms': symptoms,
        'recommendations': recommendations,
        'immediate_visit': immediate_visit,
        'ckd_education': ckd_education,
        'specialist': specialist,
        'current_date': datetime.now().strftime('%B %d, %Y')
    }

if __name__ == '__main__':
    app.run(debug=True)
